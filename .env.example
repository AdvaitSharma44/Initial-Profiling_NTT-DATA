# ============================================================================
# ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your actual values
# ============================================================================

# ============================================================================
# FASTAPI & SERVER CONFIGURATION
# ============================================================================
FASTAPI_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# EXTERNAL API KEYS (To be injected in Phase 2)
# ============================================================================

# Apollo.io API Configuration
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_API_URL=https://api.apollo.io/v1

# Clearbit API Configuration
CLEARBIT_API_KEY=your_clearbit_api_key_here
CLEARBIT_API_URL=https://company.clearbit.com/v1

# Crunchbase API Configuration
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here
CRUNCHBASE_API_URL=https://api.crunchbase.com/v4

# ============================================================================
# CURRENCY CONVERSION (Fixed for now, can be dynamic later)
# ============================================================================
USD_TO_INR_RATE=83  # $1 USD = ₹83 INR (update as needed)

# ============================================================================
# DATA FRESHNESS REQUIREMENTS
# ============================================================================
MIN_REVENUE_YEAR=2023  # Reject revenue data older than this year
PREFER_REVENUE_YEAR=2025  # Target latest data from this year

# ============================================================================
# ENRICHMENT PIPELINE SETTINGS
# ============================================================================

# Employee threshold for "Whale Catcher" logic (override missing revenue)
WHALE_MIN_EMPLOYEES=50

# Minimum revenue threshold in INR Crores (below this is suspicious)
MIN_REVENUE_THRESHOLD_CRORES=5

# Maximum retries for API calls
MAX_API_RETRIES=3

# Timeout for API calls (seconds)
API_TIMEOUT_SECONDS=30

# ============================================================================
# INTERNAL ARCHIVE / DATABASE
# ============================================================================

# Database type: sqlite, postgres, mysql (implement in Phase 2)
ARCHIVE_DB_TYPE=sqlite
ARCHIVE_DB_PATH=./data/archive.db

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# Maximum rows to process per request
MAX_ROWS=100000

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=.xlsx,.csv

# ============================================================================
# SUPPORTED REGIONS (Add/modify as needed)
# ============================================================================
SUPPORTED_REGIONS=Mumbai,Delhi,Bangalore,Hyderabad,Chennai,Pune,Kolkata,Ahmedabad,Jaipur,Lucknow

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_FILE_PATH=./logs/app.log
ENABLE_REQUEST_LOGGING=true
ENABLE_METRICS=true

# ============================================================================
# SECURITY
# ============================================================================

# Disable storing uploaded files (always in-memory)
STORE_FILES_ON_DISK=false

# Enable CORS for frontend
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Enable HTTPS (for production)
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ============================================================================
# NOTIFICATIONS (Future: Email alerts for suspicious data)
# ============================================================================
NOTIFICATION_EMAIL=admin@company.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASSWORD=your_smtp_password_here
